# ---- Super Market API ----
# Participant key from Settings -> API Keys. Needs scopes: read + trade.
SUPERMARKET_API_KEY=your_participant_api_key_here
SUPERMARKET_BASE_URL=https://sig.thesuper.market/api/v1
# Tournament slug (see `supermarket-bot status`). Resolved to a UUID on startup.
SUPERMARKET_TOURNAMENT_SLUG=midterm-elections

# ---- Safety ----
# true = compute and log orders, never submit. Start here.
SUPERMARKET_DRY_RUN=true
# Live only: cancel ALL open orders in the tournament at the start of each cycle
# (including any you placed by hand) so unfilled remainders never pile up.
SUPERMARKET_CANCEL_STALE_ORDERS=true
# When `run` stops (Ctrl-C, error, or clean stop), cancel all resting orders so
# no unmatched bids/asks linger while the bot is off. Filled positions are kept.
SUPERMARKET_CANCEL_ORDERS_ON_EXIT=true
# Limit orders expire after this many seconds (0 = never).
SUPERMARKET_ORDER_TTL_SECONDS=300

# ---- Mispricing (needs a fair-value file) ----
# Minimum edge per share (fair value - price) to open a position.
SUPERMARKET_MIN_EDGE=0.07
# Sell a position once the market reaches your fair value.
SUPERMARKET_TAKE_PROFIT=true
# Fraction of full Kelly (0.25 = quarter Kelly). Lower = safer.
SUPERMARKET_KELLY_FRACTION=0.25

# Skip an open when fair value and the best price differ by more than this.
# A gap that large usually means a bad mapping, not an opportunity.
SUPERMARKET_MAX_EDGE=0.25

# ---- External fair values (Kalshi / Polymarket, read-only, no account needed) ----
# Exchanges you approved in this file get fair values from live outside prices.
SUPERMARKET_MAPPINGS_PATH=mappings.json
SUPERMARKET_USE_KALSHI=true
SUPERMARKET_USE_POLYMARKET=true
# Ignore an outside quote with a bid-ask spread wider than this.
SUPERMARKET_EXTERNAL_MAX_SPREAD=0.08
# Skip the exchange when the two sources' midpoints differ by more than this.
SUPERMARKET_EXTERNAL_MAX_DISAGREEMENT=0.05
# Only trade exchanges where every mapped source has a usable quote.
SUPERMARKET_EXTERNAL_REQUIRE_BOTH=false
# Confidence (scales size) with one source vs two agreeing sources.
SUPERMARKET_EXTERNAL_SINGLE_CONFIDENCE=0.5
SUPERMARKET_EXTERNAL_DUAL_CONFIDENCE=0.8

# ---- Arbitrage (multi-outcome markets) ----
# Minimum locked profit per basket, in SUSQies.
SUPERMARKET_MIN_ARB_PROFIT=0.01
# Buy YES on every outcome when asks sum < 1. Only safe if exactly one outcome
# must win, so it is off by default. The NO basket is always safe.
SUPERMARKET_ALLOW_YES_BASKET_ARB=false

# Cross-market baskets from the platform's relationship graph (locked profit only).
SUPERMARKET_USE_RELATIONSHIP_ARB=true
# Re-read the relationship graph every N cycles.
SUPERMARKET_RELATIONSHIP_REFRESH_CYCLES=10

# ---- Risk caps (fractions of equity = cash + position value) ----
SUPERMARKET_MAX_MARKET_EXPOSURE=0.05
SUPERMARKET_MAX_ARB_MARKET_EXPOSURE=0.10
SUPERMARKET_MAX_TOTAL_EXPOSURE=0.60
# Net D-vs-R exposure across exchanges tagged with "lean" in the fair-value file.
SUPERMARKET_MAX_CORRELATED_EXPOSURE=0.30
# Always keep this fraction of equity as uncommitted cash.
SUPERMARKET_CASH_RESERVE=0.10

# ---- Leaderboard pacing ----
# When your rank is at or better than this, multiply Kelly by DEFEND_KELLY_SCALE.
# 0 = off.
SUPERMARKET_DEFEND_RANK=0
SUPERMARKET_DEFEND_KELLY_SCALE=0.5

# ---- Loop ----
# Seconds between cycles. A full scan takes ~3-4 minutes, so keep this well above 60.
SUPERMARKET_POLL_INTERVAL=300
SUPERMARKET_HTTP_TIMEOUT=20
SUPERMARKET_ORDERBOOK_DEPTH=20
# How many orderbook requests to run at once when scanning markets. The Super
# Market orderbook endpoint is slow and uneven, so this keeps a full scan to
# seconds instead of many minutes. Lower it if you ever see rate-limit errors.
SUPERMARKET_SCAN_CONCURRENCY=6
# Read best bid/ask for all markets in a few bulk requests, then fetch full
# orderbooks only where a trade is possible. false = fetch every orderbook.
SUPERMARKET_BULK_PRICE_SCAN=true

SUPERMARKET_LOG_LEVEL=INFO
